// Prisma Schema — Kairos Igreja
// Provider: PostgreSQL (kairos-shared-pg do Dokploy)
// A connection string fica em prisma.config.ts (Prisma 7)

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// TENANT (Multi-tenant)
// ============================================================
model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logo      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  users         User[]
  congregations Congregation[]
  members       Member[]
  celulas       Celula[]
  ministries    Ministry[]
  events        Event[]
  finances      FinancialTransaction[]
  prayers       PrayerRequest[]
  sermons       Sermon[]
  volunteers    VolunteerRoster[]
  murals        MuralNotice[]
  chats         ChatMessage[]
  assets        Asset[]
  backups       Backup[]
  conversations ChatConversation[]
  documents     Document[]
}

// ============================================================
// USUÁRIO + AUTENTICAÇÃO
// ============================================================
enum Role {
  SUPER_ADMIN
  ADMIN
  GERENTE
  OPERADOR
  USUARIO
}

model User {
  id              String    @id @default(uuid())
  tenantId        String
  congregationId  String?   // null = admin/super_admin que ve tudo
  name            String
  email           String    @unique
  passwordHash    String
  role            Role      @default(USUARIO)
  active          Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  congregation  Congregation? @relation("UserCongregation", fields: [congregationId], references: [id])
  sessions      Session[]

  conversationsA ChatConversation[] @relation("ParticipantA")
  conversationsB ChatConversation[] @relation("ParticipantB")
  chatMessages   ChatMessage[]
  documentsUploaded Document[]

  @@index([tenantId])
  @@index([congregationId])
  @@index([email])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([token])
}

// ============================================================
// CONGREGAÇÃO
// ============================================================
model Congregation {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  address   String?
  phone     String?
  pastorName String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  members Member[]
  celulas Celula[]
  users   User[]   @relation("UserCongregation")

  @@index([tenantId])
  @@index([active])
}

// ============================================================
// MEMBRO
// ============================================================
model Member {
  id             String    @id @default(uuid())
  tenantId       String
  congregationId String?
  name           String
  email          String?
  phone          String?
  birthDate      DateTime?
  address        String?
  maritalStatus  String?
  baptized       Boolean   @default(false)
  memberSince    DateTime?
  photoUrl       String?
  notes          String?
  // Campos ricos do app (cadastro pastoral completo)
  status         String    @default("membro")
  role           String?
  cpf            String?
  filiation      String?
  cardValidity   DateTime?
  baptismDate    DateTime?
  celulaId       String?
  ministries     String?
  joinedAt       DateTime  @default(now())
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  congregation Congregation? @relation(fields: [congregationId], references: [id])
  documents    Document[]

  @@index([tenantId])
  @@index([congregationId])
  @@index([active])
  @@index([name])
  @@index([status])
}

// ============================================================
// CÉLULA (Pequeno Grupo)
// ============================================================
model Celula {
  id             String    @id @default(uuid())
  tenantId       String
  congregationId String?
  name           String
  leaderName     String?
  meetingDay     String?
  meetingTime    String?
  address        String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  congregation Congregation? @relation(fields: [congregationId], references: [id])

  @@index([tenantId])
  @@index([congregationId])
}

// ============================================================
// MINISTÉRIO
// ============================================================
model Ministry {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  leaderName  String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// ============================================================
// EVENTO
// ============================================================
model Event {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  description String?
  date        DateTime
  time        String?
  location    String?
  type        String? // culto, conferência, ensaio, etc
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([date])
  @@index([active])
}

// ============================================================
// FINANÇAS
// ============================================================
enum TransactionType {
  ENTRADA
  SAIDA
}

model FinancialTransaction {
  id          String          @id @default(uuid())
  tenantId    String
  type        TransactionType
  description String
  amount      Float
  category    String?
  date        DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([date])
  @@index([type])
}

// ============================================================
// ORAÇÃO
// ============================================================
model PrayerRequest {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  request   String
  answered  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([createdAt])
}

// ============================================================
// SERMÃO
// ============================================================
model Sermon {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  passage     String?
  theme       String?
  audience    String?
  introduction String?
  conclusion  String?
  prayer      String?
  content     String? // JSON com mainPoints
  isAIGenerated Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([createdAt])
}

// ============================================================
// VOLUNTÁRIOS
// ============================================================
model VolunteerRoster {
  id         String   @id @default(uuid())
  tenantId   String
  name       String
  ministry   String?
  role       String?
  schedule   String? // JSON
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// ============================================================
// MURAL DE AVISOS
// ============================================================
model MuralNotice {
  id        String   @id @default(uuid())
  tenantId  String
  title     String
  content   String
  priority  String   @default("normal") // normal, alta, urgente
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([createdAt])
}

// ============================================================
// CHAT — DM 1:1 (estilo WhatsApp)
// ============================================================
model ChatConversation {
  id            String   @id @default(uuid())
  tenantId      String
  userAId       String
  userBId       String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant     Tenant  @relation(fields: [tenantId], references: [id])
  userA      User    @relation("ParticipantA", fields: [userAId], references: [id])
  userB      User    @relation("ParticipantB", fields: [userBId], references: [id])
  messages   ChatMessage[]

  @@unique([userAId, userBId])
  @@index([tenantId])
  @@index([userAId])
  @@index([userBId])
  @@index([lastMessageAt])
}

model ChatMessage {
  id              String   @id @default(uuid())
  tenantId        String
  conversationId  String
  senderId        String
  content         String
  readByReceiver  Boolean  @default(false)
  createdAt       DateTime @default(now())

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  conversation ChatConversation @relation(fields: [conversationId], references: [id])
  sender       User             @relation(fields: [senderId], references: [id])

  @@index([tenantId])
  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

// ============================================================
// ASSETS (Arquivos)
// ============================================================
model Asset {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  type      String   // image, document, mobilia, som, etc
  url       String
  size      Int?
  category  String?  // Categoria legada (mobilia, som, instrumento, ti, etc)
  condition String?  // Estado de conservacao
  estimatedValue Float?
  location  String?  // Onde esta guardado
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// ============================================================
// DOCUMENTOS (certidões, crachás, manuais, etc)
// ============================================================
enum DocumentType {
  BATISMO
  OBREIRO
  CRACHA
  EQUIPAMENTO
  OUTRO
}

model Document {
  id           String       @id @default(uuid())
  tenantId     String
  memberId     String?      // null = documento solto (ex: manual de impressora)
  uploadedById String       // quem fez upload
  title        String
  description  String?
  type         DocumentType @default(OUTRO)
  url          String       // caminho /uploads/<tenantId>/<arquivo>
  fileName     String       // nome original
  fileSize     Int          // bytes
  mimeType     String
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  member      Member?  @relation(fields: [memberId], references: [id])
  uploadedBy  User     @relation(fields: [uploadedById], references: [id])

  @@index([tenantId])
  @@index([memberId])
  @@index([type])
  @@index([createdAt])
}

// ============================================================
// BACKUP
// ============================================================
model Backup {
  id         String   @id @default(uuid())
  tenantId   String
  filename   String
  size       Int
  type       String   @default("local") // local, gdrive, onedrive, s3
  path       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([createdAt])
}